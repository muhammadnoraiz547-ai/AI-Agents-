    {
      "parameters": {
        "jsCode": "const data = $('Save Draft DB').first().json.length ? $('Add Hashes + ID').first().json : $('Add Hashes + ID').first().json;\nconst base = $('Add Hashes + ID').first().json;\nreturn (base.scenes || []).map(scene => ({\n  json: {\n    contentId: base.contentId,\n    title: base.title,\n    voiceoverEnabled: base.voiceoverEnabled,\n    ...scene\n  }\n}));"
      },
