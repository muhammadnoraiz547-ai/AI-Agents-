    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-goog-api-key",
              "value": "={{$node[\"Configuration\"].json.geminiApiKey}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [ { parts: [ { text: 'Write a short-form video script for this angle. Topic: ' + $json.topic + '. Angle: ' + $json.angle + '. Return ONLY strict JSON: {\\\"title\\\":\\\"...\\\",\\\"scenes\\\":[{\\\"sceneNumber\\\":1,\\\"visualPrompt\\\":\\\"...\\\",\\\"voiceoverText\\\":\\\"...\\\",\\\"onScreenText\\\":\\\"...\\\"}]}' } ] } ] }) }}",
        "options": {}
      },
      "id": "6ca0551d-b4bd-4b07-8998-4c458bfea071",
      "name": "4. Generate Script",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1200,
        720
      ]
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst raw = $json.candidates[0].content.parts[0].text;\nconst cleaned = raw.replace(/```json|```/g, '').trim();\nlet script = {};\ntry { script = JSON.parse(cleaned); } catch (e) { script = { title: 'Untitled', scenes: [] }; }\nconst prev = $('Parse Dup Result').first().json;\nconst scriptHash = crypto.createHash('sha256').update(JSON.stringify(script)).digest('hex');\nconst contentId = crypto.randomUUID();\nreturn [{\n  json: {\n    contentId,\n    topic: prev.topic,\n    angle: prev.angle,\n    angleHash: prev.angleHash,\n    scriptHash,\n    title: script.title,\n    scenes: script.scenes,\n    voiceoverEnabled: $('Configuration').first().json.voiceoverEnabled\n  }\n}];"
      },
