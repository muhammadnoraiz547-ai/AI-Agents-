    {
      "parameters": {
        "jsCode": "// Runs once the Split Scenes loop is finished (\"done\" output).\nconst base = $('Add Hashes + ID').first().json;\nconst uploaded = $('Upload Image').all();\nconst images = uploaded.map((item, idx) => ({\n  sceneNumber: idx + 1,\n  imageUrl: item.json.url || item.json.publicUrl || item.json.data\n}));\nreturn [{ json: { ...base, images } }];"
      },
