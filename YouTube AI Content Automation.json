    {
      "parameters": {
        "jsCode": "// Build a compact text list of previously published titles, angles and hashes\n// so Gemini can be given context to avoid duplicates.\nconst dbItems = $('Load Content DB').all();\nconst summaryLines = dbItems.map(i => `- ${i.json.title} | angle: ${i.json.angle} | hash: ${i.json.angleHash}`);\nconst topic = $('Filter Pending').first().json;\nreturn [{\n  json: {\n    ...topic,\n    previousContentSummary: summaryLines.join('\\n'),\n    previousHashes: dbItems.map(i => i.json.angleHash)\n  }\n}];"
      },
      "id": "c326b37e-13ae-4340-bbcd-c9a3c450a969",
      "name": "Prepare Previous",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        -1840,
        32
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-goog-api-key",
              "value": "={{$node[\"Configuration\"].json.geminiApiKey}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [ { parts: [ { text: 'Analyze this topic for a short-form video and summarize the key facts, hook potential and target audience. Topic: ' + $json.topic + '. Description: ' + $json.description } ] } ] }) }}",
        "options": {}
      },
      "id": "eaf085a7-47e8-4eb9-af74-efa25a68260d",
      "name": "1. Analyze Topic",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1616,
        32
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-goog-api-key",
              "value": "={{$node[\"Configuration\"].json.geminiApiKey}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [ { parts: [ { text: 'Based on this analysis, propose ONE unique content angle that is different from these previous angles:\\n' + $('Prepare Previous').first().json.previousContentSummary + '\\n\\nAnalysis: ' + $json.candidates[0].content.parts[0].text + '\\n\\nReturn ONLY the angle in one short sentence.' } ] } ] }) }}",
        "options": {}
      },
      "id": "2d43dd15-aaaf-4762-84fc-1508b30442b4",
      "name": "2. Generate Angle",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1392,
        32
      ]
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst angle = $json.candidates[0].content.parts[0].text.trim();\nconst hash = crypto.createHash('sha256').update(angle.toLowerCase()).digest('hex');\nconst previousHashes = $('Prepare Previous').first().json.previousHashes || [];\nreturn [{\n  json: {\n    ...$('Prepare Previous').first().json,\n    angle,\n    angleHash: hash,\n    isHashDuplicate: previousHashes.includes(hash)\n  }\n}];"
      },
      "id": "a57dd967-7b23-4a7c-a988-7a64905e58ce",
      "name": "Hash Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        -1168,
        32
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-goog-api-key",
              "value": "={{$node[\"Configuration\"].json.geminiApiKey}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [ { parts: [ { text: 'Compare the NEW angle to the list of PREVIOUS angles/titles and decide if it is a semantic duplicate (same core idea even if worded differently).\\n\\nNEW ANGLE: ' + $json.angle + '\\n\\nPREVIOUS:\\n' + $json.previousContentSummary + '\\n\\nRespond ONLY with strict JSON: {\\\"isDuplicate\\\": true|false, \\\"reason\\\": \\\"...\\\"}' } ] } ] }) }}",
        "options": {}
      },
      "id": "3e453750-34e2-449e-876a-782412a08e42",
      "name": "3. Semantic Dup Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -944,
        32
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.candidates[0].content.parts[0].text;\nconst cleaned = raw.replace(/```json|```/g, '').trim();\nlet parsed = { isDuplicate: false, reason: 'parse_failed' };\ntry { parsed = JSON.parse(cleaned); } catch (e) {}\nconst prev = $('Hash Check').first().json;\nreturn [{ json: { ...prev, isSemanticDuplicate: parsed.isDuplicate, dupReason: parsed.reason } }];"
      },
      "id": "db5bc509-5be7-4096-868a-84d687677bf3",
      "name": "Parse Dup Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        -720,
        32
      ]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{$json.isHashDuplicate || $json.isSemanticDuplicate}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          }
        },
        "options": {}
      },
      "id": "ffdf662f-8464-44e0-964f-717769b4cb8d",
      "name": "IF Duplicate",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
