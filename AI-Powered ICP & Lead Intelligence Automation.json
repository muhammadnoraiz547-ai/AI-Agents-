    {
      "parameters": {
        "jsCode": "// Get companies from get_lookalikes output\nconst items = $input.all();\nlet companies = [];\n\nif (items.length > 0 && items[0].json.organic) {\n    companies = items[0].json.organic;\n} else if (items.length > 0 && Array.isArray(items[0].json)) {\n    companies = items[0].json;\n}\n\nconst companySummary = companies.map((c, i) => \n    `${i + 1}. ${c.title || 'No Title'}\\n${c.snippet || 'No description'}\\n${c.link || 'No link'}\\n`\n).join('\\n\\n');\n\nreturn [{\n    json: {\n        companies: companies,\n        summary: companySummary || \"No companies found\",\n        totalCompanies: companies.length\n    }\n}];"
      },
