    {
      "parameters": {
        "jsCode": "const narration = $input.first().json.narration || $node[\"Edit Fields1\"].json.narration || \"\";\n\n// Narration ko chhote pieces mein todo (har scene ~10-12 seconds)\nfunction splitText(text, maxLength = 140) {\n  const sentences = text.match(/[^.!?]+[.!?]+/g) || [text];\n  const chunks = [];\n  let current = \"\";\n\n  for (const sentence of sentences) {\n    if ((current + sentence).length > maxLength && current) {\n      chunks.push(current.trim());\n      current = sentence;\n    } else {\n      current += \" \" + sentence;\n    }\n  }\n  if (current.trim()) chunks.push(current.trim());\n  return chunks.slice(0, 5); // max 5 scenes (free plan safe)\n}\n\nconst chunks = splitText(narration);\n\nconst scenes = chunks.map((text, index) => {\n  return {\n    \"duration\": 11,\n    \"background-color\": index % 2 === 0 ? \"#0f172a\" : \"#1e293b\",\n    \"elements\": [\n      {\n        \"type\": \"text\",\n        \"style\": \"001\",\n        \"text\": text,\n        \"duration\": 11,\n        \"settings\": {\n          \"font-size\": \"38px\",\n          \"font-family\": \"Arial\",\n          \"color\": \"#ffffff\",\n          \"text-align\": \"center\",\n          \"vertical-align\": \"middle\",\n          \"line-height\": \"1.45\",\n          \"padding\": \"40px\"\n        }\n      }\n    ]\n  };\n});\n\nconst videoJson = {\n  \"resolution\": \"full-hd\",\n  \"quality\": \"high\",\n  \"scenes\": scenes\n};\n\nreturn [\n  {\n    json: {\n      narration: narration,\n      videoPayload: videoJson,\n      sceneCount: scenes.length\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
