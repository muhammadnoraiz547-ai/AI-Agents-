    {
      "parameters": {
        "jsCode": "const event = $input.first().json;\nconst et = (event.eventType || '').toLowerCase();\n\n// Basic deterministic pre-routing hints + context keys needed\nconst contextNeeds = {\n  abandoned_checkout: ['customer', 'cart', 'products', 'inventory', 'discount_history', 'previous_orders'],\n  order_created: ['customer', 'order', 'products'],\n  order_delayed: ['customer', 'order', 'tracking', 'order_value', 'history'],\n  fulfillment_exception: ['customer', 'order', 'tracking', 'order_value', 'history'],\n  return_requested: ['customer', 'order', 'product', 'return_history', 'reason'],\n  inventory_low: ['product', 'inventory', 'sales_velocity', 'supplier'],\n  customer_inactive: ['customer', 'last_order', 'order_frequency', 'favorites', 'aov'],\n  customer_message: ['customer', 'message', 'history', 'products', 'inventory'],\n  review_received: ['customer', 'order', 'product', 'review']\n};\n\nreturn [{\n  json: {\n    ...event,\n    contextNeeds: contextNeeds[et] || ['customer', 'order'],\n    preRouteHint: et\n  }\n}];"
      },
      "id": "85e5fd71-76cf-43d5-8494-5d64aef878e7",
      "name": "Plan Context Collection",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
