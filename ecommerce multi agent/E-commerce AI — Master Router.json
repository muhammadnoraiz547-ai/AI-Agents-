    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst now = new Date().toISOString();\n\nconst normalized = {\n  eventType: body.eventType || body.event_type || body.type || 'unknown',\n  timestamp: body.timestamp || now,\n  storeId: body.storeId || body.shop_id || body.shop || 'default_store',\n  customerId: body.customerId || body.customer_id || (body.customer && body.customer.id) || null,\n  orderId: body.orderId || body.order_id || (body.order && body.order.id) || null,\n  productId: body.productId || body.product_id || (body.product && body.product.id) || null,\n  cartId: body.cartId || body.cart_id || body.checkout_id || null,\n  payload: body.payload || body,\n  raw: body\n};\n\nreturn [{ json: normalized }];"
      },
      "id": "d3817b91-6614-4275-86cc-8db1863e353f",
      "name": "Normalize Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
