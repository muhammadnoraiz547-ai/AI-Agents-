    {
      "parameters": {
        "jsCode": "// Context Collector (MVP — uses payload data + placeholders for Shopify HTTP)\n// In production, replace placeholders with real HTTP Request nodes using SHOPIFY_ADMIN_API credential\nconst item = $input.first().json;\nconst p = item.payload || {};\nconst event = item;\n\n// Simulate / extract context from incoming payload (works with test data)\nconst context = {\n  customer: p.customer || (event.customerId ? { id: event.customerId, name: p.customerName || 'Customer', email: p.email || null, previousOrders: p.previousOrders || 0, lifetimeValue: p.ltv || 0 } : null),\n  cart: p.cart || (event.cartId ? { id: event.cartId, value: p.cartValue || p.total_price || 0, items: p.items || [] } : null),\n  order: p.order || (event.orderId ? { id: event.orderId, value: p.orderValue || p.total_price || 0, status: p.status || 'unknown', createdAt: p.created_at || null } : null),\n  product: p.product || (event.productId ? { id: event.productId, name: p.productName || 'Product', inventory: p.inventory || p.inventory_quantity || null } : null),\n  inventory: p.inventory !== undefined ? { quantity: p.inventory, salesLast24h: p.salesLast24h || 0 } : null,\n  tracking: p.tracking || p.fulfillment || null,\n  returnReason: p.reason || p.return_reason || null,\n  message: p.message || p.body || p.text || null,\n  discountHistory: p.discountHistory || [],\n  previousInteractions: p.previousInteractions || [],\n  salesVelocity: p.salesLast24h || p.sales_velocity || 0\n};\n\nreturn [{\n  json: {\n    event: {\n      eventType: event.eventType,\n      timestamp: event.timestamp,\n      storeId: event.storeId,\n      customerId: event.customerId,\n      orderId: event.orderId,\n      productId: event.productId,\n      cartId: event.cartId\n    },\n    context,\n    rawPayload: p\n  }\n}];"
      },
      "id": "fe031ebf-fc00-4736-903d-0ad26c7df7bb",
      "name": "Collect Context (Shopify-ready)",
