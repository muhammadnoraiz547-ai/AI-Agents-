        "jsCode": "const agentResult = $input.first().json;\nconst upstream = $('Parse & Validate AI Router Output').first().json;\n\nconst standardized = {\n  agent: agentResult.agent || upstream.routing?.agent || 'unknown',\n  decision: agentResult.decision || 'UNKNOWN',\n  action: agentResult.action || '',\n  confidence: agentResult.confidence || upstream.routing?.confidence || 0,\n  reason: agentResult.reason || upstream.routing?.reason || '',\n  customerId: agentResult.customerId || upstream.event?.customerId || '',\n  orderId: agentResult.orderId || upstream.event?.orderId || '',\n  status: agentResult.status || 'completed',\n  timestamp: new Date().toISOString(),\n  eventType: upstream.event?.eventType || '',\n  channel: agentResult.channel || '',\n  message: agentResult.message || '',\n  escalate: agentResult.escalate || false,\n  priority: agentResult.priority || upstream.routing?.priority || 'medium',\n  result: agentResult\n};\n\nreturn [{ json: standardized }];"
