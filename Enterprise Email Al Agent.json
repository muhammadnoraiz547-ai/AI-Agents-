      "parameters": {
        "promptType": "define",
        "text": "=EMAIL RECEIVED:\n━━━━━━━━━━━━━━━━━━━━\nSubject:  {{ $('Gmail Trigger').item.json.Subject }}\nFrom: {{ $('Gmail Trigger').item.json.From }}\nCategory: Buisness\n━━━━━━━━━━━━━━━━━━━━\n\nCONTENT:\n{{ $('Gmail Trigger').first().json.snippet }}\n\n━━━━━━━━━━━━━━━━━━━━\n\nTASK:\nDraft a professional workplace email response that:\n1. Addresses all points raised in the email\n2. Maintains formal, professional tone\n3. Provides clear next steps if needed\n4. Keeps response concise (2-3 paragraphs max)\n\nGenerate the reply.",
        "options": {
          "systemMessage": "=You are a business development email assistant specializing in client communication, sales, and partnerships.\n\nCONTEXT:\n- Handle emails about sales inquiries, client proposals, vendor communications, partnerships\n- Maintain professional yet friendly tone\n- Focus on building relationships and closing deals\n\nINSTRUCTIONS:\n1. Identify the business opportunity or inquiry\n2. Assess client/vendor intent and urgency\n3. Draft responses that:\n   - Show enthusiasm and interest\n   - Address specific questions or concerns\n   - Suggest clear next steps (meeting, call, proposal)\n   - Include call-to-action\n\nRESPONSE STYLE:\n- Professional but warm\n- Solution-oriented\n- Include specific details (pricing, timeline, deliverables)\n- Always end with clear next step\n\nEMAIL DETAILS:\nSubject: {{ $('Gmail Trigger').first().json.subject }}\nFrom: {{ $('Gmail Trigger').first().json.from }}\nContent: {{ $('Gmail Trigger').first().json.snippet }}\n\nDraft a business-appropriate response that moves the conversation forward."
        }
      },
