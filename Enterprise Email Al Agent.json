        "inputText": "=Email Subject: {{ $json['emailSubject  '] }}\nFrom:   {{ $json.senderEmail }}\nContent: {{ $json.emailBody }}\n\nClassify this email into: Work, Business, Personal, or Others",
        "categories": {
