              "category": "Work",
              "description": "Emails related to job, workplace tasks, meetings, project updates, team communication, manager requests, work deadlines, office announcements, and professional workplace matters"
            },
            {
              "category": "Buisness",
              "description": "Emails about sales inquiries, client proposals, vendor communications, partnership opportunities, business deals, invoices, contracts, B2B communications, and entrepreneurial matters"
            },
            {
              "category": "Personal ",
              "description": "Emails from friends, family members, personal contacts, casual conversations, social invitations, personal appointments, and non-work related communications"
            },
            {
              "category": "Others",
              "description": "Newsletters, marketing emails, promotional content, spam, automated notifications, subscriptions, unclear emails, and anything that doesn't fit Work, Business, or Personal categories"
