    {
      "parameters": {
        "jsCode": "const inputJson = $input.first().json;\nconst leads = inputJson.newLeads || inputJson.data || [];\n\nconst getField = (l, key) => (l.fields ? l.fields[key] : l[key]) || '';\n\nconst bySource = {};\nfor (const l of leads) {\n  const src = getField(l, 'source') || 'unknown';\n  bySource[src] = (bySource[src] || 0) + 1;\n}\nconst breakdown = Object.entries(bySource).map(([k, v]) => `• ${k}: ${v}`).join(\"\\n\") || \"No new leads this run.\";\nconst sample = leads.slice(0, 5).map(l => `— ${getField(l,'fullName')} (${getField(l,'jobTitle')} @ ${getField(l,'company')})`).join(\"\\n\");\n\nreturn [{\n  json: {\n    summary: `🚀 **Lead Scraper Run Complete**\\n\\nNew leads found: **${leads.length}**\\n\\n**By account:**\\n${breakdown}\\n\\n**Sample:**\\n${sample || \"—\"}`\n  }\n}];"
      },
