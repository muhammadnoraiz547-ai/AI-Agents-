      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Duplicate rows hata do - unique Client_ID se\nconst uniqueRows = [];\nconst seenIds = new Set();\n\nfor (const item of items) {\n  const id = item.json.Client_ID;\n  if (id && id !== '' && !seenIds.has(id)) {\n    seenIds.add(id);\n    uniqueRows.push(item);\n  }\n}\n\nconst totalEmails = uniqueRows.length;\nconst sentSuccessfully = uniqueRows.filter(item => item.json.Status === 'Sent').length;\nconst failed = uniqueRows.filter(item => item.json.Status === 'Failed').length;\nconst successRate = totalEmails > 0 ? ((sentSuccessfully / totalEmails) * 100).toFixed(2) : 0;\n\nreturn [{json: {\n  totalEmails,\n  sentSuccessfully,\n  failed,\n  successRate: successRate + '%'\n}}];"
      },
