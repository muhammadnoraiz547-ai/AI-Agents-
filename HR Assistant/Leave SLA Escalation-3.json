      "parameters": {
        "jsCode": "\nconst contexts = $('Match Request To Approval').all().map(i => i.json);\nconst managers = $input.all().map(i => i.json);\nreturn contexts.map(ctx => {\n  const mgr = managers.find(e => e.employee_id === ctx.manager_id);\n  return { json: { ...ctx, manager_telegram_id: mgr ? mgr.telegram_id : '', manager_name: mgr ? mgr.name : 'Manager' } };\n});\n"
      },
