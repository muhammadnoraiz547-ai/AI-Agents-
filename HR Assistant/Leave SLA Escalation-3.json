      "parameters": {
        "jsCode": "\nconst approvals = $('Needs Escalation?').all().map(i => i.json);\nconst requests = $input.all().map(i => i.json);\nreturn approvals.map(approval => {\n  const req = requests.find(r => r.request_id === approval.request_id);\n  return { json: { ...approval, ...(req || {}) } };\n});\n"
      },
