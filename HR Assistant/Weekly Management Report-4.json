    {
      "parameters": {
        "numberInputs": 4
      },
      "id": "88eacec6-5520-4ad9-ac9d-20e4cec5afe1",
      "name": "Merge Weekly Data Sources",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.1,
      "position": [
        336,
        368
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst employees = $('Fetch Employees').all().map(i => i.json);\nconst leaveRequests = $('Fetch Leave Requests').all().map(i => i.json);\nconst tickets = $('Fetch Tickets').all().map(i => i.json);\nconst approvals = $('Fetch Approvals').all().map(i => i.json);\n\nconst oneWeekAgo = Date.now() - 7 * 24 * 3600000;\nconst isThisWeek = (dateStr) => {\n  const t = new Date(dateStr).getTime();\n  return !isNaN(t) && t >= oneWeekAgo;\n};\n\nconst weeklyLeaveRequests = leaveRequests.filter(r => isThisWeek(r.created_at));\nconst weeklyTickets = tickets.filter(t => isThisWeek(t.created_at));\n\nconst kpis = {\n  total_employees: employees.length,\n  total_leave_requests: weeklyLeaveRequests.length,\n  approved_leaves: weeklyLeaveRequests.filter(r => r.status === 'Approved').length,\n  rejected_leaves: weeklyLeaveRequests.filter(r => r.status === 'Rejected').length,\n  pending_leaves: weeklyLeaveRequests.filter(r => r.status === 'Pending').length,\n  total_tickets: weeklyTickets.length,\n  open_tickets: weeklyTickets.filter(t => t.status === 'Open').length,\n  resolved_tickets: weeklyTickets.filter(t => t.status === 'Resolved').length,\n  high_priority_tickets: weeklyTickets.filter(t => t.priority === 'high').length,\n  critical_tickets: weeklyTickets.filter(t => t.priority === 'critical').length,\n  sla_escalations: approvals.filter(a => String(a.escalated).toLowerCase() === 'true' && isThisWeek(a.escalated_at)).length\n};\nreturn [{ json: kpis }];\n"
      },
      "id": "9b1af82f-6434-40f4-9b2a-f038a2f3c20e",
      "name": "Calculate KPIs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        688,
        336
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"temperature\": 0.2,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are an executive assistant summarizing weekly HR/IT operations metrics for management. Summarize ONLY the numeric data provided below - do not invent or estimate any additional metrics. Write 3-5 concise sentences highlighting notable trends (e.g. high pending leave counts, SLA escalations, critical tickets) in a professional tone suitable for a management email.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": 'Weekly KPIs: ' + JSON.stringify($json)\n    }\n  ]\n} }}",
        "options": {
          "timeout": 20000
        }
      },
      "id": "f5879c04-6355-41f4-8c77-39ae20e3c353",
      "name": "AI Management Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        896,
        336
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "mhOQeSt5BsgcvVbG",
          "name": "Header Auth account"
        }
      },
      "continueOnFail": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "\nconst kpis = $('Calculate KPIs').first().json;\nlet summary = 'Summary unavailable.';\ntry { summary = $input.first().json.choices[0].message.content; } catch (e) {}\n\nconst row = (label, value) => `<tr><td style=\"padding:6px 12px;border-bottom:1px solid #eee;\">${label}</td><td style=\"padding:6px 12px;border-bottom:1px solid #eee;text-align:right;font-weight:600;\">${value}</td></tr>`;\n\nconst html = `\n<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:auto;\">\n  <h2 style=\"color:#2c3e50;\">Weekly Management Report</h2>\n  <p style=\"color:#555;\">${summary}</p>\n  <table style=\"width:100%;border-collapse:collapse;margin-top:16px;\">\n    ${row('Total Employees', kpis.total_employees)}\n    ${row('Total Leave Requests (7d)', kpis.total_leave_requests)}\n    ${row('Approved Leaves', kpis.approved_leaves)}\n    ${row('Rejected Leaves', kpis.rejected_leaves)}\n    ${row('Pending Leaves', kpis.pending_leaves)}\n    ${row('Total Tickets (7d)', kpis.total_tickets)}\n    ${row('Open Tickets', kpis.open_tickets)}\n    ${row('Resolved Tickets', kpis.resolved_tickets)}\n    ${row('High Priority Tickets', kpis.high_priority_tickets)}\n    ${row('Critical Tickets', kpis.critical_tickets)}\n    ${row('SLA Escalations', kpis.sla_escalations)}\n  </table>\n</div>`;\nreturn [{ json: { html_body: html } }];\n"
      },
      "id": "14094521-53f5-40f8-a146-1a652f7ba66a",
      "name": "Build HTML Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        336
