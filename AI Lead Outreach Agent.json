    {
      "parameters": {
        "jsCode": "// Array untuk menampung hasil yang akan dikirim ke node selanjutnya\nconst outputItems = [];\n\n// Loop melalui setiap item yang masuk dari node sebelumnya\nfor (const item of items) {\n  try {\n    // 1. Ambil nama perusahaan dari English column\n    const companyName = item.json.Company;\n\n    // 2. URL Encode karo (spaces aur special characters ke liye)\n    const companyNameEncoded = encodeURIComponent(companyName);\n\n    // 3. Naya object banao with all original data + new encoded field\n    const outputData = {\n      ...item.json,                    // Saare original fields copy karo\n      perusahaan_url_encoded: companyNameEncoded   // New field for webhook link\n    };\n\n    // Output mein add karo\n    outputItems.push({ json: outputData });\n\n  } catch (error) {\n    // Agar koi error aaye (jaise Company field na ho) to item ko aise hi forward kar do\n    console.error(\"Error in Code node:\", error);\n    outputItems.push(item);\n  }\n}\n\n// Return processed items\nreturn outputItems;"
      },
