            "idea": "={{ $json.idea }}",
            "hook1": "={{ $json.hook1 }}",
            "hook2": "={{ $json.hook2 }}",
            "full_draft": "={{ $json.full_draft }}",
            "status": "pending"
          }
        },
        "options": {}
