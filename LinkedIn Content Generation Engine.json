    {
      "parameters": {
        "chatId": "={{ $json.chat_id }}",
        "text": "=🎯 *New LinkedIn Draft Ready*\n\n*Idea:* {{ $json.idea }}\n\n---\n\n*Hook 1:*\n{{ $json.hook1 }}\n\n*Hook 2:*\n{{ $json.hook2 }}\n\n---\n\n*Full Draft:*\n{{ $json.full_draft }}\n\n---\nChoose one:",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "✅ Approve Hook 1",
                    "additionalFields": {
                      "callback_data": "=approve1_{{ $json.id }}"
                    }
                  },
                  {
                    "text": "✅ Approve Hook 2",
                    "additionalFields": {
                      "callback_data": "=approve2_{{ $json.id }}"
                    }
                  }
                ]
              }
            },
            {
              "row": {
                "buttons": [
                  {
                    "text": "✏️ Keep for later",
                    "additionalFields": {
                      "callback_data": "=later_{{ $json.id }}"
                    }
                  },
                  {
                    "text": "❌ Discard",
                    "additionalFields": {
                      "callback_data": "=discard_{{ $json.id }}"
                    }
                  }
                ]
              }
            }
          ]
        },
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
