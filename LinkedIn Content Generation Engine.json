      "id": "f6422c57-3da5-4118-84ea-b9b520587b27",
      "name": "Groq Whisper Transcribe",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        688,
        112
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "UKbCqUiZS7rm4EgY",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"temperature\": 0.7,\n  \"response_format\": { \"type\": \"json_object\" },\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a LinkedIn content engine for a busy Indian founder/builder. Style rules:\\n- Direct, conversational, slightly raw, desi-founder energy\\n- Short paragraphs, strong first line\\n- Mix of English + natural Hinglish when it feels right\\n- No corporate fluff, no hashtags, no emojis overload\\n- Story + insight + soft CTA\\n- Keep full_draft under 220 words\\n\\nOutput ONLY valid JSON with exactly these keys:\\n{\\n  \\\"idea\\\": \\\"one-line core idea\\\",\\n  \\\"hook1\\\": \\\"first strong hook\\\",\\n  \\\"hook2\\\": \\\"second different strong hook\\\",\\n  \\\"full_draft\\\": \\\"complete LinkedIn post using one of the hooks\\\"\\n}\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Voice transcript:\\n\\n{{ $json.text }}\\n\\nCreate 2 hooks + full draft in the style above.\"\n    }\n  ]\n}",
        "options": {}
      },
      "id": "a3c67ea0-6866-445e-984a-109f11a29e2c",
      "name": "Generate Idea + 2 Hooks + Draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        912,
        112
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "UKbCqUiZS7rm4EgY",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.choices[0].message.content;\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  // fallback if model wraps it\n  const match = raw.match(/\\{[\\s\\S]*\\}/);\n  parsed = match ? JSON.parse(match[0]) : { idea: raw, hook1: '', hook2: '', full_draft: raw };\n}\n\nconst id = `ln_${Date.now()}_${Math.random().toString(36).slice(2, 7)}`;\nconst chatId = $('Telegram Trigger').item.json.message.chat.id;\nconst transcript = $('Groq Whisper Transcribe').item.json.text;\n\nreturn [{\n  json: {\n    id,\n    created_at: new Date().toISOString(),\n    chat_id: chatId,\n    transcript,\n    idea: parsed.idea || '',\n    hook1: parsed.hook1 || '',\n    hook2: parsed.hook2 || '',\n    full_draft: parsed.full_draft || '',\n    status: 'pending'\n  }\n}];"
      },
      "id": "193f6778-7d61-4b55-b92d-931a3923f944",
      "name": "Parse JSON + Create ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1136,
        112
      ]
    },
