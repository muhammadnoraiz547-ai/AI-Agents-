    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst body = input.body || {};\nconst rawItems = Array.isArray(body) ? body : (body.items || []);\nconst existing = new Set(input.existingUrls || []);\nconst out = [];\n\nfor (const raw of rawItems) {\n  const profileUrl = raw.profileUrl || raw.url || raw.linkedinUrl;\n  if (!profileUrl || existing.has(profileUrl)) continue;\n\n  // Actor sends name + job title combined in \"title\", e.g. \"Shahnawaz - Digital Marketing Manager\"\n  const rawTitle = (raw.title || raw.name || 'Unknown').replace(/[\\u200e\\u200f]/g, '').trim();\n  let fullName = rawTitle;\n  let jobTitle = '';\n  const dashIndex = rawTitle.indexOf(' - ');\n  if (dashIndex !== -1) {\n    fullName = rawTitle.slice(0, dashIndex).trim();\n    jobTitle = rawTitle.slice(dashIndex + 3).trim();\n  }\n\n  out.push({\n    json: {\n      fullName: fullName,\n      jobTitle: jobTitle,\n      company: '',\n      profileUrl: profileUrl,\n      email: '',\n      source: input.accountName,\n      searchQuery: input.searchQuery,\n      matchedLocation: input.location || '',\n      matchedIndustry: input.industry || '',\n      scrapedAt: raw.scrapedAt || new Date().toISOString()\n    }\n  });\n  existing.add(profileUrl);\n}\n\nreturn out;"
      },
