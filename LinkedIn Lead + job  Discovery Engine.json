    {
      "parameters": {
        "jsCode": "const criteriaItems = $input.all();\nconst existingJobUrls = $('Aggregate Existing Job URLs').first().json.existingJobUrls || [];\n\nreturn criteriaItems.map(item => {\n  const c = item.json;\n  const keywords = encodeURIComponent(c.jobTitle || '');\n  const location = encodeURIComponent(c.location || '');\n  const jobSearchUrl = `https://www.linkedin.com/jobs/search/?keywords=${keywords}&location=${location}`;\n\n  return {\n    json: {\n      criteriaId: c.criteriaId || '',\n      jobTitle: c.jobTitle || '',\n      location: c.location || '',\n      industry: c.industry || '',\n      jobSearchUrl: jobSearchUrl,\n      existingJobUrls: existingJobUrls\n    }\n  };\n});"
      },
