        -1296,
        352
      ]
    },
    {
      "parameters": {
        "jsCode": "const existingUrls = $('Aggregate Existing URLs').first().json.existingUrls || [];\nconst criteriaRows = $input.all();\n\nreturn criteriaRows.map(item => {\n  const c = item.json;\n\n  const titleParts = (c.jobTitle || '').split(',').map(t => t.trim()).filter(Boolean);\n  const titleBlock = titleParts.length ? `(${titleParts.map(t => `\\\"${t}\\\"`).join(' OR ')})` : '';\n\n  let query = `site:linkedin.com/in ${titleBlock}`.trim();\n  if (c.industry) query += ` \\\"${c.industry}\\\"`;\n  if (c.location) query += ` \\\"${c.location}\\\"`;\n\n  return {\n    json: {\n      criteriaId: c.id || c.recordId || item.json.id || '',\n      jobTitle: c.jobTitle || '',\n      location: c.location || '',\n      industry: c.industry || '',\n      searchQuery: query.trim(),\n      existingUrls\n    }\n  };\n});"
      },
      "id": "ee5391e0-a43b-4543-8dde-55d20c74b6a5",
      "name": "Build Search Queries",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1072,
        352
      ]
    },
    {
      "parameters": {
        "jsCode": "const criteriaItems = $input.all();\n\n// ⬇️ apna asal Apify actorId aur apifyToken yahan bharein (env vars n8n Cloud pr code node mein kaam nahi karte)\nconst accounts = [\n  { accountName: \"apify_account_1\", actorId: \"PASTE_YOUR_ACTOR_ID_1\", apifyToken: \"PASTE_YOUR_APIFY_TOKEN_1\" },\n  { accountName: \"apify_account_2\", actorId: \"PASTE_YOUR_ACTOR_ID_2\", apifyToken: \"PASTE_YOUR_APIFY_TOKEN_2\" },\n  { accountName: \"apify_account_3\", actorId: \"PASTE_YOUR_ACTOR_ID_3\", apifyToken: \"PASTE_YOUR_APIFY_TOKEN_3\" },\n  { accountName: \"apify_account_4\", actorId: \"PASTE_YOUR_ACTOR_ID_4\", apifyToken: \"PASTE_YOUR_APIFY_TOKEN_4\" },\n  { accountName: \"apify_account_5\", actorId: \"PASTE_YOUR_ACTOR_ID_5\", apifyToken: \"PASTE_YOUR_APIFY_TOKEN_5\" }\n];\n\nconst out = [];\nfor (const item of criteriaItems) {\n  const c = item.json;\n  for (const acc of accounts) {\n    out.push({\n      json: {\n        accountName: acc.accountName,\n        actorId: acc.actorId,\n        apifyToken: acc.apifyToken,\n        searchQuery: c.searchQuery,\n        criteriaId: c.criteriaId,\n        jobTitle: c.jobTitle,\n        location: c.location,\n        industry: c.industry,\n        existingUrls: c.existingUrls || []\n      }\n    });\n  }\n}\nreturn out;"
      },
