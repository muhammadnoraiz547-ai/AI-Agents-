        "jsCode": "const input = $input.first().json;\nconst body = input.body || {};\nconst rawItems = Array.isArray(body) ? body : (body.items || []);\nconst existing = new Set(input.existingJobUrls || []);\nconst out = [];\n\nfor (const raw of rawItems) {\n  const jobUrl = raw.link || raw.url || raw.jobUrl;\n  if (!jobUrl || existing.has(jobUrl)) continue;\n\n  out.push({\n    json: {\n      jobTitle: raw.title || '',\n      company: raw.companyName || raw.company || '',\n      location: raw.location || input.location || '',\n      jobUrl: jobUrl,\n      salary: raw.salary || '',\n      description: raw.description || '',\n      postedDate: raw.postedDate || raw.listedAt || '',\n      source: 'apify_jobs_actor',\n      searchQuery: input.jobSearchUrl || '',\n      scrapedAt: new Date().toISOString()\n    }\n  });\n  existing.add(jobUrl);\n}\n\nreturn out;"
