    {
      "parameters": {
        "jsCode": "const item = $input.first().json || {};\n\n// ------------------- Get AI Response Text -------------------\nconst rawText = item.output?.text || item.text || item.response || \"\";\n\n// ------------------- Parse AI JSON -------------------\nlet aiJson = {};\ntry {\n  const jsonMatch = rawText.match(/```json\\s*([\\s\\S]+?)\\s*```/i);\n  \n  if (jsonMatch && jsonMatch[1]) {\n    aiJson = JSON.parse(jsonMatch[1].trim());\n  } else {\n    aiJson = JSON.parse(rawText);\n  }\n} catch (e) {\n  console.log(\"JSON Parse Error - using defaults\");\n  aiJson = {};\n}\n\n// ------------------- Get Original Data -------------------\nlet originalData = {\n  email: item.email || \"\",\n  first_name: item.first_name || item.first_Name || \"\",\n  company_name: item.company_name || item.company_Name || \"\",\n  website: item.website || \"\",\n  cleanedData: item.cleanedData || \"\"\n};\n\n// Try to get from previous nodes if not in current item\nif (!originalData.email) {\n  // Check if Get row(s) in sheet was executed (Schedule Trigger path)\n  try {\n    const sheetData = $node[\"Get row(s) in sheet\"].json;\n    if (sheetData && sheetData.email) {\n      originalData.email = sheetData.email;\n      originalData.first_name = sheetData.first_name || sheetData.first_Name;\n      originalData.company_name = sheetData.company_name || sheetData.company_Name;\n      originalData.website = sheetData.website;\n    }\n  } catch (e) {\n    // Node not executed (Chat Trigger path) - use item data\n    console.log(\"Using data from current item\");\n  }\n  \n  // Check HTTP Request node if still no email\n  if (!originalData.email) {\n    try {\n      const httpData = $node[\"HTTP Request: Get Website\"].json;\n      if (httpData && httpData.email) {\n        originalData.email = httpData.email;\n        originalData.first_name = httpData.first_name || httpData.first_Name;\n        originalData.company_name = httpData.company_name || httpData.company_Name;\n        originalData.website = httpData.website;\n      }\n    } catch (e) {\n      console.log(\"HTTP Request node not found\");\n    }\n  }\n}\n\n// ------------------- Build Final Output -------------------\nconst finalData = {\n  // Original data (MUST preserve)\n  email: originalData.email,\n  first_name: originalData.first_name,\n  company_name: originalData.company_name,\n  website: originalData.website,\n  cleanedData: originalData.cleanedData,\n  status: \"sent\",\n  \n  // AI Generated Fields\n  subject: aiJson.subject || `Partnership Opportunity`,\n  greeting: aiJson.greeting || `Hi ${originalData.first_name || 'there'},`,\n  opening_line: aiJson.opening_line || \"I came across your company.\",\n  main_body: aiJson.main_body || \"We have a solution for you.\",\n  ending: aiJson.ending || \"Looking forward to hearing from you!\"\n};\n\nreturn [{ json: finalData }];"
      },
