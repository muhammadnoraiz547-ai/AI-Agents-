          "conditions": [
            {
              "id": "844ae7ce-d7ad-4742-9e88-8a73ec5abd59",
              "operator": {
                "type": "string",
                "operation": "regex"
              },
              "leftValue": "={{ $json.email }}",
              "rightValue": "/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/"
            }
          ]
        },
        "looseTypeValidation": true,
        "options": {}
